{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "playwright.config.ts",
    "tests/ui/**/*.ts",
    "tests/support/fixtures/**/*.ts",
    "tests/support/locators/**/*.ts",
    "tests/support/pages/**/*.ts",
    "tests/support/routes/**/*.ts"
  ]
}
